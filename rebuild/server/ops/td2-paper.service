[Unit]
Description=TradeDesk rebuild paper runner (engine replay on recorded prices; never sends an order)
After=network-online.target td2-api.service

[Service]
User=tradedesk
WorkingDirectory=/opt/td2/app/rebuild/server
EnvironmentFile=/opt/td2/secrets/td2.env
ExecStart=/opt/td2/venv/bin/python -m tdserver.paper
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
# reads the store; writes only paper session state under the runs folder
ReadWritePaths=/opt/td2/data /opt/td2/store
PrivateTmp=true
MemoryMax=700M

[Install]
WantedBy=multi-user.target
