[Unit]
Description=TradeDesk rebuild portfolio sync (owner's Zerodha holdings, read-only; never places an order)
After=network-online.target td2-api.service

[Service]
User=tradedesk
WorkingDirectory=/opt/td2/app/rebuild/server
EnvironmentFile=/opt/td2/secrets/td2.env
ExecStart=/opt/td2/venv/bin/python -m tdserver.portfolio.sync
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
# talks to Zerodha (holdings, trades, daily prices) and writes only the database
ReadWritePaths=/opt/td2/data /opt/td2/store
PrivateTmp=true
MemoryMax=300M

[Install]
WantedBy=multi-user.target
