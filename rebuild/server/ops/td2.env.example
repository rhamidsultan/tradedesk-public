# /opt/td2/secrets/td2.env  (chmod 600, owner tradedesk). Never commit the real file.
TD2_ENV=prod
TD2_DATABASE_URL=postgresql+psycopg://td2:<password>@127.0.0.1/td2
# python -m tdserver.cli new-master-key
TD2_MASTER_KEY=
TD2_PUBLIC_BASE_URL=https://td2.<your-ip-with-dashes>.sslip.io
# from @BotFather; leave empty to use ntfy only
TD2_TELEGRAM_BOT_TOKEN=
TD2_NTFY_SERVER=https://ntfy.sh
# the Parquet market-data store (a copy of ~/Trading/tradedesk-store); the recorder writes today's bars here
TD2_STORE_ROOT=/opt/td2/store

# Live orders are possible only while this root-owned file exists (outside every TradeDesk write path).
# Create it after the 1-lot order test: sudo mkdir -p /etc/td2 && sudo touch /etc/td2/live-ENABLED
TD2_LIVE_ENABLED_FILE=/etc/td2/live-ENABLED
